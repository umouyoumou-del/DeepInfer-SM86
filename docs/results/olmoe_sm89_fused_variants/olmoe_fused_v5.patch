+// Pulls `count` 16-byte words into L2 while another kernel runs; the result is
+// only written if the XOR of everything read hits one fixed value, which keeps
+// the loads without a store per thread.
+extern "C" __global__ void fz_prefetch(
+    const uint4* __restrict__ data, long long count, unsigned int* __restrict__ sink)
+{
+    unsigned int acc = 0u;
+    const long long stride = (long long)gridDim.x * blockDim.x;
+    #pragma unroll 4
+    for (long long i = (long long)blockIdx.x * blockDim.x + threadIdx.x; i < count; i += stride) {
+        const uint4 v = __ldcg(data + i);
+        acc ^= v.x ^ v.y ^ v.z ^ v.w;
+    }
+    if (acc == 0x9e3779b9u) *sink = acc;
+}
+
